{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SupabaseStorage": {
    "BucketName": "recordings",
    "ProjectUrl": "supabase_project_url",
    "ServiceRoleKey": "supabase_service_role_key"
  },
  "Workshop": {
    "FromNumber": "your_vonage_from_number",
    "WebhookBaseUrl": "https://your-public-domain.com"
  },
  "vonage": {
    "Application.Id": "your_vonage_application_id",
    "Application.Key": "./Configuration/Keys/vonage_workshop_private_key.key"
  }
}